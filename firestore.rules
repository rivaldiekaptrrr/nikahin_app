rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Fungsi cek apakah request berasal dari Super Admin
    function isAdmin() {
      return request.auth != null && 
             request.auth.token.email == 'rivaldiekaputr@gmail.com' &&
             (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'password');
    }

    // Fungsi cek apakah request berasal dari pemilik data
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Collection User & Lisensi
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() || (
        request.auth != null && resource != null && 'partnerOfUid' in resource.data && resource.data.partnerOfUid == request.auth.uid
      );
      
      // User baru hanya boleh mendaftarkan akun dengan status NONE. Hanya Admin yang boleh mengatur status lain.
      allow create: if (isOwner(userId) && (!('accessLevel' in request.resource.data) || request.resource.data.accessLevel == 'NONE')) 
                    || isAdmin();
                    
      // User biasa TIDAK BOLEH mengubah accessLevel miliknya sendiri (mencegah privilege escalation).
      // Hanya Admin yang berhak memodifikasi accessLevel.
      // Izinkan pasangan yang mengklaim kode untuk menautkan dirinya ke user lain tanpa mengubah accessLevel user lain.
      // Izinkan juga memutuskan tautan (unlink) oleh salah satu pihak yang sebelumnya tertaut.
      allow update: if (isOwner(userId) && (!('accessLevel' in request.resource.data) || request.resource.data.accessLevel == resource.data.accessLevel)) 
                    || (request.auth != null && 
                        resource != null &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['partnerOfUid', 'activeWeddingId', 'coupleRole', 'updatedAt']) &&
                        (
                          // Menautkan pasangan baru (claim code)
                          request.resource.data.partnerOfUid == request.auth.uid ||
                          // Memutuskan tautan pasangan oleh pihak yang tertaut sebelumnya
                          resource.data.partnerOfUid == request.auth.uid
                        ))
                    || isAdmin();
                    
      allow delete: if isAdmin();
    }

    // Dokumen Pernikahan & Modul Planner (Multi-Tenant per User Legacy)
    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId) || isAdmin() || (
        request.auth != null && get(/databases/$(database)/documents/users/$(userId)).data.partnerOfUid == request.auth.uid
      );
    }

    // Shared Wedding Workspace (Multi-Tenant Couple Workspace)
    match /weddings/{weddingId} {
      allow read: if request.auth != null && (
        resource == null || resource.data.members.hasAny([request.auth.uid]) || isAdmin()
      );
      
      // Maksimum 2 member (Pengantin Pria + Pengantin Wanita)
      allow create, update: if request.auth != null && (
        (request.resource.data.members.size() <= 2 && request.resource.data.members.hasAny([request.auth.uid])) || 
        isAdmin()
      );
      
      allow delete: if isAdmin();
    }

    // Shared Wedding Workspace Subcollections (budget, rundown, guests, committee, etc.)
    match /weddings/{weddingId}/{collection}/{docId} {
      allow read, write: if request.auth != null && (
        get(/databases/$(database)/documents/weddings/$(weddingId)).data.members.hasAny([request.auth.uid]) || isAdmin()
      );
    }

    // Pairing Codes (Anti-Enumeration / Strict Lookup)
    match /pairing_codes/{code} {
      // allow get: Verifikasi dan klaim kode satuan diizinkan bagi user login
      allow get: if request.auth != null;
      
      // allow list: Enumerasi/scanning seluruh kode dilarang keras untuk mencegah brute force
      allow list: if false;
      
      allow create, update: if request.auth != null && (
        request.resource.data.creatorUid == request.auth.uid ||
        (resource != null && resource.data.status == 'active' && request.resource.data.claimedByUid == request.auth.uid) ||
        isAdmin()
      );
      
      allow delete: if request.auth != null && (
        (resource != null && resource.data.creatorUid == request.auth.uid) || isAdmin()
      );
    }

    // ===============================================================
    // Voucher, Pricing & Channel Attribution Collections
    // ===============================================================

    function isValidPricingConfig(data) {
      return data.keys().hasAll(['defaultPrice', 'minAllowedPrice']) &&
             data.keys().hasOnly(['defaultPrice', 'minAllowedPrice', 'updatedAt']) &&
             data.defaultPrice is number && data.defaultPrice >= 0 &&
             data.minAllowedPrice is number && data.minAllowedPrice >= 0 &&
             (!('updatedAt' in data) || data.updatedAt is int || data.updatedAt is number);
    }

    function isValidVoucher(data) {
      return data.keys().hasAll(['code', 'channel', 'discountType', 'discountValue', 'isActive', 'usedCount']) &&
             data.keys().hasOnly(['code', 'channel', 'description', 'discountType', 'discountValue', 'isActive', 'maxQuota', 'usedCount', 'validFrom', 'validUntil', 'createdAt', 'updatedAt']) &&
             data.code is string && data.code.size() >= 2 && data.code.size() <= 32 &&
             data.channel is string && data.channel.size() >= 1 && data.channel.size() <= 40 &&
             (!('description' in data) || data.description == null || (data.description is string && data.description.size() <= 200)) &&
             data.discountType in ['FIXED', 'PERCENT'] &&
             data.discountValue is number && data.discountValue >= 0 &&
             (data.discountType != 'PERCENT' || data.discountValue <= 100) &&
             data.isActive is bool &&
             (!('maxQuota' in data) || data.maxQuota == null || (data.maxQuota is int && data.maxQuota > 0)) &&
             data.usedCount is int && data.usedCount >= 0 &&
             (!('validFrom' in data) || data.validFrom == null || data.validFrom is int || data.validFrom is number) &&
             (!('validUntil' in data) || data.validUntil == null || data.validUntil is int || data.validUntil is number) &&
             (!('createdAt' in data) || data.createdAt is int || data.createdAt is number) &&
             (!('updatedAt' in data) || data.updatedAt is int || data.updatedAt is number);
    }

    // Konfigurasi Harga Global (Dibaca publik untuk pricing display, write eksklusif Admin)
    match /app_config/pricing {
      allow get: if true;
      allow list: if false;
      allow create, update: if isAdmin() && isValidPricingConfig(request.resource.data);
      allow delete: if isAdmin();
    }

    // Master Vouchers (Anti-Enumeration bagi user biasa, Full CRUD bagi Admin)
    match /vouchers/{code} {
      allow get: if request.auth != null;
      allow list: if isAdmin();
      allow create, update: if isAdmin() && isValidVoucher(request.resource.data);
      allow delete: if isAdmin();
    }

    // Log Penukaran Voucher (Hanya Admin SDK Webhook yang boleh menulis)
    match /voucher_redemptions/{orderId} {
      allow read: if isAdmin() || (request.auth != null && resource != null && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    // Pending Orders sementara untuk bridge Midtrans metadata (Server-Only)
    match /pending_orders/{orderId} {
      allow read, write: if false;
    }
  }
}
